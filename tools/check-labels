#!/usr/bin/env python3
"""Validate a skill's eval label hygiene and corpus parsing contract.

Opt-in per skill: a skill is checked only if it ships
``evals/label-check.json``. Without that file the skill is skipped cleanly —
this gate is not something every skill has to grow.

Two checks, both objective:

1. Every rule label used by ``evals.json`` (``對應規則``) and, when the config
   declares a ``corpus``, that corpus's 規則 column resolves to a name the
   skill itself declares.
2. Every ``引文片段`` in a corpus judgment table is an exact substring of that
   case's clean quote, per the 解析契約. ``全文`` is the sole exception.

The config declares *where the names live*, never the names themselves, so
there is still no taxonomy manifest to drift out of sync with the rules:

    {
      "corpus": "evals/corpus.md",          // optional, relative to skill dir
      "names": ["保護清單"],                 // optional literal additions
      "expectation_classes": ["改寫保真"],   // optional, see below
      "sources": [                           // required, at least one
        {"file": "references/zh-rules.md", "regex": "(?m)^### (.+)$",
         "capture": 1, "prefix": ""}
      ]
    }

``expectation_classes`` is declared apart from the rules on purpose. A label
like 改寫保真 is a *cross-rule* expectation — it names what the output must
preserve regardless of which rule fired — so it has no ``###`` header to be
derived from, and folding it into ``names`` would say it is a rule. Both sets
satisfy a label, but they are declared separately so a missing name reports
against the namespace it should have come from.

A ``sources`` entry may whitelist rather than sweep. Where a file mixes rule
headers with headers that are not rules, name the ones that count in the
regex (``^## (四字評語)``) instead of capturing every header: ``resolve`` is
exact by design, and a non-rule name admitted to the canonical set turns a
typo elsewhere into a legal label.

A declared file that is missing is a hard error, not a skip: the skill opted
in, so a vanished rule file is a defect rather than an absent feature.

Read-only: it never writes to the test data it validates.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

CASE_RE = re.compile(r"^### ([HA]-\d\d) — ")
SECTION_RE = re.compile(r"^## ")
SEPARATOR_RE = re.compile(r"^\|[\s\-:|]+\|$")
FENCE = "````"
WHOLE_TEXT = "全文"


class CorpusError(Exception):
    """Raised when the corpus cannot be parsed under the 解析契約."""


def strip_template_fences(text: str) -> list[str]:
    """Drop the fenced 樣板 block; the contract says it is not a real case."""
    lines, kept, inside = text.split("\n"), [], False
    for line in lines:
        if line.startswith(FENCE):
            inside = not inside
            continue
        if not inside:
            kept.append(line)
    if inside:
        raise CorpusError("unterminated four-backtick fence")
    return kept


def join_quote(quote_lines: list[str]) -> str:
    """Join layout-wrapped lines with the empty string, keeping real breaks."""
    paragraphs, buffer = [], []
    for line in quote_lines:
        if line:
            buffer.append(line)
        elif buffer:
            paragraphs.append("".join(buffer))
            buffer = []
    if buffer:
        paragraphs.append("".join(buffer))
    return "".join(paragraphs)


def parse_corpus(path: Path) -> list[dict]:
    """Return one record per case: id, clean quote, and its judgment rows."""
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise CorpusError(f"cannot read {path}: {exc}") from exc

    cases: list[dict] = []
    current: dict | None = None
    in_quote = False
    table_started = False

    for line in strip_template_fences(raw):
        match = CASE_RE.match(line)
        if match:
            current = {"id": match.group(1), "quote_lines": [], "rows": []}
            cases.append(current)
            in_quote, table_started = False, False
            continue

        if SECTION_RE.match(line) and not line.startswith("###"):
            current = None
            continue

        if current is None:
            continue

        if line.startswith(">"):
            if not current["rows"]:
                in_quote = True
                current["quote_lines"].append(line[1:].strip())
            continue
        if in_quote and not line.strip():
            current["quote_lines"].append("")
            continue
        if in_quote:
            in_quote = False

        if not line.startswith("|") or SEPARATOR_RE.match(line):
            continue

        cells = [c.strip() for c in line.strip("|").split("|")]
        if cells and cells[0] == "引文片段":
            table_started = True
            current["malformed"] = current.get("malformed", 0)
            continue
        if not table_started:
            continue
        if len(cells) != 4:
            # Inside a judgment table every row is four columns. A row that
            # is not is a parse failure, not something to skip quietly.
            current["malformed"] = current.get("malformed", 0) + 1
            continue
        current["rows"].append(
            {"frag": cells[0], "verdict": cells[2], "rule": cells[3]}
        )

    for case in cases:
        case["quote"] = join_quote(case["quote_lines"])
        case.setdefault("malformed", None)
    return cases


CONFIG_PATH = Path("evals") / "label-check.json"
SOURCE_KEYS = {"file", "regex", "capture", "prefix"}
CONFIG_KEYS = {"corpus", "names", "expectation_classes", "sources"}


class ConfigError(Exception):
    """Raised when ``evals/label-check.json`` is present but unusable."""


def load_config(skill_dir: Path) -> dict | None:
    """Return the validated config, or None when the skill has not opted in."""
    path = skill_dir / CONFIG_PATH
    if not path.exists():
        return None
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ConfigError(f"{path}: {exc}") from exc
    if not isinstance(raw, dict):
        raise ConfigError(f"{path}: top level must be an object")

    unknown = set(raw) - CONFIG_KEYS
    if unknown:
        raise ConfigError(f"{path}: unknown key(s) {sorted(unknown)}")

    sources = raw.get("sources")
    if not isinstance(sources, list) or not sources:
        raise ConfigError(f"{path}: 'sources' must be a non-empty list")
    for index, source in enumerate(sources):
        _validate_source(path, index, source)

    names = raw.get("names", [])
    if not isinstance(names, list) or any(not isinstance(n, str) for n in names):
        raise ConfigError(f"{path}: 'names' must be a list of strings")

    classes = raw.get("expectation_classes", [])
    if not isinstance(classes, list) or any(not isinstance(n, str) for n in classes):
        raise ConfigError(
            f"{path}: 'expectation_classes' must be a list of strings"
        )

    corpus = raw.get("corpus")
    if corpus is not None and not isinstance(corpus, str):
        raise ConfigError(f"{path}: 'corpus' must be a string path")

    return {
        "corpus": corpus,
        "names": names,
        "expectation_classes": classes,
        "sources": sources,
    }


def _validate_source(path: Path, index: int, source: object) -> None:
    where = f"{path}: sources[{index}]"
    if not isinstance(source, dict):
        raise ConfigError(f"{where} must be an object")
    unknown = set(source) - SOURCE_KEYS
    if unknown:
        raise ConfigError(f"{where}: unknown key(s) {sorted(unknown)}")
    for key in ("file", "regex"):
        if not isinstance(source.get(key), str) or not source[key]:
            raise ConfigError(f"{where}: '{key}' is required and must be a string")
    try:
        compiled = re.compile(source["regex"])
    except re.error as exc:
        raise ConfigError(f"{where}: bad regex — {exc}") from exc
    capture = source.get("capture", 0)
    if not isinstance(capture, int) or isinstance(capture, bool) or capture < 0:
        raise ConfigError(f"{where}: 'capture' must be a non-negative integer")
    if capture > compiled.groups:
        raise ConfigError(
            f"{where}: 'capture' is {capture} but the regex has "
            f"{compiled.groups} group(s)"
        )
    if not isinstance(source.get("prefix", ""), str):
        raise ConfigError(f"{where}: 'prefix' must be a string")


def load_canonical(skill_dir: Path, config: dict) -> set[str]:
    """Derive the canonical rule names from what the skill itself declares.

    The rule files stay the single source of truth — the config only says
    which files to read and how to pull names out of them.
    """
    names: set[str] = set(config["names"])
    for source in config["sources"]:
        target = skill_dir / source["file"]
        if not target.exists():
            raise ConfigError(f"missing declared rule file: {target}")
        capture = source.get("capture", 0)
        prefix = source.get("prefix", "")
        text = target.read_text(encoding="utf-8")
        for match in re.finditer(source["regex"], text):
            name = match.group(capture).strip()
            if name:
                names.add(f"{prefix}{name}")
    return names


def base_name(label: str) -> str:
    """Strip a trailing justification and any carve-out suffix."""
    name = label.split("（")[0].split("(")[0].strip()
    for suffix in (" carve-out", "carve-out"):
        if name.endswith(suffix):
            name = name[: -len(suffix)].strip()
    return name


def resolve(name: str, canonical: set[str], expectations: set[str]) -> bool:
    """Membership is exact, across both declared namespaces. Sub-signals and
    protection items are declared too, so a plausible-looking child of a real
    parent is still a failure."""
    return name in canonical or name in expectations


def check_corpus(
    corpus_path: Path, canonical: set[str], expectations: set[str]
) -> list[str]:
    """Validate the 解析契約 and every 規則 label in a corpus's tables."""
    if not corpus_path.exists():
        return [f"missing declared corpus {corpus_path}"]

    failures: list[str] = []
    cases = parse_corpus(corpus_path)
    if not cases:
        failures.append(f"{corpus_path}: parsed zero cases")
    for case in cases:
        flat = case["quote"]
        if case["malformed"] is None:
            failures.append(
                f"{case['id']}: no judgment table found "
                "(is the 引文片段 header row intact?)"
            )
        elif case["malformed"]:
            failures.append(
                f"{case['id']}: {case['malformed']} judgment row(s) are not "
                "4 columns — a literal | in a cell breaks the contract"
            )
        if case["malformed"] is not None and not case["rows"]:
            failures.append(f"{case['id']}: judgment table has no rows")
        for row in case["rows"]:
            frag = row["frag"]
            if frag != WHOLE_TEXT and frag not in flat:
                failures.append(
                    f"{case['id']}: 引文片段 is not a substring of the "
                    f"clean quote: {frag[:40]!r}"
                )
            if row["verdict"] not in {"ok", "flag"}:
                failures.append(
                    f"{case['id']}: 判定 must be ok or flag, "
                    f"got {row['verdict']!r}"
                )
            name = base_name(row["rule"])
            if not name:
                failures.append(
                    f"{case['id']}: 規則 names no rule "
                    f"(got {row['rule'][:40]!r})"
                )
            elif not resolve(name, canonical, expectations):
                failures.append(
                    f"{case['id']}: 規則 {name!r} is not a declared rule "
                    "or expectation class"
                )
    return failures


def check_skill(skill_dir: Path, config: dict) -> list[str]:
    failures: list[str] = []
    canonical = load_canonical(skill_dir, config)
    if not canonical:
        return [f"{skill_dir}: no rule names declared"]
    expectations = set(config["expectation_classes"])
    overlap = canonical & expectations
    if overlap:
        return [
            f"{skill_dir}: {sorted(overlap)} declared both as a rule and as "
            "an expectation class — one name, one namespace"
        ]

    if config["corpus"]:
        failures.extend(
            check_corpus(skill_dir / config["corpus"], canonical, expectations)
        )

    evals_path = skill_dir / "evals" / "evals.json"
    if not evals_path.exists():
        return failures + [f"missing {evals_path}"]
    try:
        data = json.loads(evals_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return failures + [f"{evals_path}: {exc}"]
    for case in data.get("evals", []):
        if "對應規則" not in case:
            continue
        name = base_name(case["對應規則"])
        if not name:
            failures.append(
                f"evals id {case.get('id')}: 對應規則 names no rule "
                f"(got {case['對應規則'][:40]!r})"
            )
        elif not resolve(name, canonical, expectations):
            failures.append(
                f"evals id {case.get('id')}: 對應規則 {name!r} "
                "is not a declared rule or expectation class"
            )
    return failures


def run_one(name: str, skill_dir: Path) -> tuple[int, list[str]]:
    """Check one skill. Returns (exit code, failure lines) and prints its own
    one-line verdict, so `--all` and single-skill mode read the same."""
    try:
        config = load_config(skill_dir)
    except ConfigError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2, []
    if config is None:
        print(f"{name}: no {CONFIG_PATH} — skipped")
        return 0, []

    try:
        failures = check_skill(skill_dir, config)
    except (ConfigError, CorpusError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2, []

    if failures:
        print(f"{name}: {len(failures)} problem(s)")
        return 1, [f"{name}: {line}" for line in failures]

    print(f"{name}: labels and 解析契約 OK")
    return 0, []


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "skill", nargs="?", help="skill slug under skills/; omit with --all"
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="check every skill that ships evals/label-check.json",
    )
    args = parser.parse_args()
    if bool(args.skill) == args.all:
        parser.error("give a skill slug or --all, not both or neither")

    repo_root = Path(__file__).resolve().parent.parent
    skills_root = repo_root / "skills"

    if args.skill:
        targets = [(args.skill, skills_root / args.skill)]
        if not targets[0][1].is_dir():
            print(f"no such skill: {targets[0][1]}", file=sys.stderr)
            return 2
    else:
        targets = [(d.name, d) for d in sorted(skills_root.iterdir()) if d.is_dir()]

    worst, all_failures = 0, []
    for name, skill_dir in targets:
        code, failures = run_one(name, skill_dir)
        worst = max(worst, code)
        all_failures.extend(failures)

    if all_failures:
        print()
        for line in all_failures:
            print(f"FAIL {line}")
        print(f"\n{len(all_failures)} problem(s)")
    return worst


if __name__ == "__main__":
    sys.exit(main())
