#!/usr/bin/env python3
"""Validate a skill's eval label hygiene and corpus parsing contract.

Two checks, both objective:

1. Every rule label used by ``evals.json`` (``對應規則``) and ``corpus.md``
   (the 規則 column) resolves to a name declared in the skill's canonical
   taxonomy.
2. Every ``引文片段`` in a corpus judgment table is an exact substring of that
   case's clean quote, per the 解析契約. ``全文`` is the sole exception.

Read-only: it never writes to the test data it validates.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

CASE_RE = re.compile(r"^### ([HA]-\d\d) — ")
SECTION_RE = re.compile(r"^## ")
SEPARATOR_RE = re.compile(r"^\|[\s\-:|]+\|$")
FENCE = "````"
WHOLE_TEXT = "全文"


class CorpusError(Exception):
    """Raised when the corpus cannot be parsed under the 解析契約."""


def strip_template_fences(text: str) -> list[str]:
    """Drop the fenced 樣板 block; the contract says it is not a real case."""
    lines, kept, inside = text.split("\n"), [], False
    for line in lines:
        if line.startswith(FENCE):
            inside = not inside
            continue
        if not inside:
            kept.append(line)
    if inside:
        raise CorpusError("unterminated four-backtick fence")
    return kept


def join_quote(quote_lines: list[str]) -> str:
    """Join layout-wrapped lines with the empty string, keeping real breaks."""
    paragraphs, buffer = [], []
    for line in quote_lines:
        if line:
            buffer.append(line)
        elif buffer:
            paragraphs.append("".join(buffer))
            buffer = []
    if buffer:
        paragraphs.append("".join(buffer))
    return "".join(paragraphs)


def parse_corpus(path: Path) -> list[dict]:
    """Return one record per case: id, clean quote, and its judgment rows."""
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise CorpusError(f"cannot read {path}: {exc}") from exc

    cases: list[dict] = []
    current: dict | None = None
    in_quote = False
    table_started = False

    for line in strip_template_fences(raw):
        match = CASE_RE.match(line)
        if match:
            current = {"id": match.group(1), "quote_lines": [], "rows": []}
            cases.append(current)
            in_quote, table_started = False, False
            continue

        if SECTION_RE.match(line) and not line.startswith("###"):
            current = None
            continue

        if current is None:
            continue

        if line.startswith(">"):
            if not current["rows"]:
                in_quote = True
                current["quote_lines"].append(line[1:].strip())
            continue
        if in_quote and not line.strip():
            current["quote_lines"].append("")
            continue
        if in_quote:
            in_quote = False

        if not line.startswith("|") or SEPARATOR_RE.match(line):
            continue

        cells = [c.strip() for c in line.strip("|").split("|")]
        if cells and cells[0] == "引文片段":
            table_started = True
            current["malformed"] = current.get("malformed", 0)
            continue
        if not table_started:
            continue
        if len(cells) != 4:
            # Inside a judgment table every row is four columns. A row that
            # is not is a parse failure, not something to skip quietly.
            current["malformed"] = current.get("malformed", 0) + 1
            continue
        current["rows"].append(
            {"frag": cells[0], "verdict": cells[2], "rule": cells[3]}
        )

    for case in cases:
        case["quote"] = join_quote(case["quote_lines"])
        case.setdefault("malformed", None)
    return cases


MECHANISMS = {"保護清單", "長文scope"}
PROTECTION_ITEM_RE = re.compile(r"[①②③④⑤⑥⑦⑧⑨⑩]([^（(\s]+)")


def load_canonical(skill_dir: Path) -> set[str]:
    """Derive the canonical rule names from what the skill itself declares.

    The rule files are the single source of truth, so there is no separate
    taxonomy manifest to drift out of sync with them.
    """
    names: set[str] = set(MECHANISMS)

    rules = skill_dir / "references" / "zh-rules.md"
    if not rules.exists():
        raise CorpusError(f"missing rule file: {rules}")
    for line in rules.read_text(encoding="utf-8").split("\n"):
        if line.startswith("### "):
            names.add(line[4:].strip())

    signals = skill_dir / "references" / "hidden-author.md"
    if not signals.exists():
        raise CorpusError(f"missing rule file: {signals}")
    for match in re.finditer(
        r"作者隱身／[^\s、（()|`*。，]+", signals.read_text(encoding="utf-8")
    ):
        names.add(match.group(0))

    # Protection-list items are enumerated in the skill's step 2, as ①…⑧.
    skill_md = skill_dir / "SKILL.md"
    if not skill_md.exists():
        raise CorpusError(f"missing {skill_md}")
    for match in PROTECTION_ITEM_RE.finditer(skill_md.read_text(encoding="utf-8")):
        names.add(f"保護清單／{match.group(1)}")
    return names


def base_name(label: str) -> str:
    """Strip a trailing justification and any carve-out suffix."""
    name = label.split("（")[0].split("(")[0].strip()
    for suffix in (" carve-out", "carve-out"):
        if name.endswith(suffix):
            name = name[: -len(suffix)].strip()
    return name


def resolve(name: str, canonical: set[str]) -> bool:
    """Membership is exact. Sub-signals and protection items are declared too,
    so a plausible-looking child of a real parent is still a failure."""
    return name in canonical


def check_skill(skill_dir: Path) -> list[str]:
    failures: list[str] = []
    canonical = load_canonical(skill_dir)
    if not canonical:
        return [f"{skill_dir}: no rule names declared"]

    corpus_path = skill_dir / "evals" / "corpus.md"
    if not corpus_path.exists():
        failures.append(f"missing {corpus_path}")
    else:
        cases = parse_corpus(corpus_path)
        if not cases:
            failures.append(f"{corpus_path}: parsed zero cases")
        for case in cases:
            flat = case["quote"]
            if case["malformed"] is None:
                failures.append(
                    f"{case['id']}: no judgment table found "
                    "(is the 引文片段 header row intact?)"
                )
            elif case["malformed"]:
                failures.append(
                    f"{case['id']}: {case['malformed']} judgment row(s) are not "
                    "4 columns — a literal | in a cell breaks the contract"
                )
            if case["malformed"] is not None and not case["rows"]:
                failures.append(f"{case['id']}: judgment table has no rows")
            for row in case["rows"]:
                frag = row["frag"]
                if frag != WHOLE_TEXT and frag not in flat:
                    failures.append(
                        f"{case['id']}: 引文片段 is not a substring of the "
                        f"clean quote: {frag[:40]!r}"
                    )
                if row["verdict"] not in {"ok", "flag"}:
                    failures.append(
                        f"{case['id']}: 判定 must be ok or flag, "
                        f"got {row['verdict']!r}"
                    )
                name = base_name(row["rule"])
                if not name:
                    failures.append(
                        f"{case['id']}: 規則 names no rule "
                        f"(got {row['rule'][:40]!r})"
                    )
                elif not resolve(name, canonical):
                    failures.append(
                        f"{case['id']}: 規則 {name!r} is not in the canonical list"
                    )

    evals_path = skill_dir / "evals" / "evals.json"
    if not evals_path.exists():
        return failures + [f"missing {evals_path}"]
    try:
        data = json.loads(evals_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return failures + [f"{evals_path}: {exc}"]
    for case in data.get("evals", []):
        if "對應規則" not in case:
            continue
        name = base_name(case["對應規則"])
        if not name:
            failures.append(
                f"evals id {case.get('id')}: 對應規則 names no rule "
                f"(got {case['對應規則'][:40]!r})"
            )
        elif not resolve(name, canonical):
            failures.append(
                f"evals id {case.get('id')}: 對應規則 {name!r} "
                "is not in the canonical list"
            )
    return failures


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("skill", nargs="?", default="humanizer-zh")
    args = parser.parse_args()

    repo_root = Path(__file__).resolve().parent.parent
    skill_dir = repo_root / "skills" / args.skill
    if not skill_dir.is_dir():
        print(f"no such skill: {skill_dir}", file=sys.stderr)
        return 2

    try:
        failures = check_skill(skill_dir)
    except CorpusError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    if failures:
        for line in failures:
            print(f"FAIL {line}")
        print(f"\n{len(failures)} problem(s)")
        return 1

    print(f"{args.skill}: labels and 解析契約 OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
