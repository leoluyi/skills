def _review_card(
    args: argparse.Namespace,
    config: dict,
    by_id: dict[int, dict],
    skill_dir: Path,
    entries: list[dict],
) -> int:
    """Print the unblinded review card for one case, then stop."""
    case = by_id.get(args.review_card)
    if case is None:
        raise AnnotateError(f"no such case id in the fixture: {args.review_card}")
    blind = by_pass(entries, BLIND).get(args.review_card)
    if blind is None:
        raise AnnotateError(
            f"case {args.review_card} has no blind verdict yet; review is the second pass, "
            "not the first"
        )
    card = build_card(case, config)
    if card.blocked:
        raise AnnotateError(f"case {card.case_id} is needs-manual: {card.blocked}")
    classes = key_classes(skill_dir) if config["verdict_class_from"] else {}
    klass, basis = classes.get(card.case_id, (None, "unavailable"))
    print(REVIEW_INSTRUCTION)
    print()
    print(build_review_card(case, card, blind, klass, basis))
    return 0


def _review(
    args: argparse.Namespace,
    config: dict,
    by_id: dict[int, dict],
    skill_dir: Path,
    ledger_path: Path,
    rendered_path: Path,
    entries: list[dict],
) -> int:
    """Record one unblinded review verdict beside its blind verdict."""
    case = by_id.get(args.review)
    if case is None:
        raise AnnotateError(f"no such case id in the fixture: {args.review}")
    blind = by_pass(entries, BLIND).get(args.review)
    if blind is None:
        raise AnnotateError(
            f"case {args.review} has no blind verdict to review; run --record first"
        )
    if args.disposition not in DISPOSITIONS:
        raise AnnotateError(
            f"--disposition must be one of {list(DISPOSITIONS)}"
        )
    card = build_card(case, config)
    if card.blocked:
        raise AnnotateError(f"case {card.case_id} is needs-manual: {card.blocked}")

    # Defaults to the blind score: a review that only assigns blame is the
    # common case, and forcing the author to retype an unchanged number invites
    # a typo that would read as a changed mind.
    score = args.score if args.score is not None else blind["score"]
    rationale = (args.rationale or "").strip()
    if not rationale:
        raise AnnotateError(
            "複審一律需要 --rationale：解盲之後的判斷是要拿去改 key 的依據，"
            "盲判那條「1 與 2 可留空」的規則不適用"
        )
    if args.review in by_pass(entries, REVIEW) and not args.redo:
        raise AnnotateError(
            f"case {args.review} already has a review; pass --redo to overwrite it"
        )

    classes = key_classes(skill_dir) if config["verdict_class_from"] else {}
    klass, basis = classes.get(card.case_id, (None, "unavailable"))
    na_reason = (ai_index_na(skill_dir) if config["verdict_class_from"] else {}).get(card.case_id)
    entry = {
        "case_id": card.case_id,
        "score": score,
        "rationale": rationale,
        "date": date.today().isoformat(),
        "genre": card.genre,
        "spans": list(card.spans),
        "span_sha256": span_digest(card.spans),
        "key_class": klass,
        "key_class_basis": basis,
        "contradicts_key": None if na_reason else contradicts(score, klass),
        "pass": REVIEW,
        "disposition": args.disposition,
        "superseded_by": None,
    }
    if na_reason:
        entry["ai_index_na"] = na_reason
    kept = [
        e for e in entries if not (e["case_id"] == card.case_id and entry_pass(e) == REVIEW)
    ]
    for existing in kept:
        if existing["case_id"] == card.case_id and entry_pass(existing) == BLIND:
            existing["superseded_by"] = REVIEW
    entries = kept + [entry]
    save_ledger(ledger_path, args.skill, entries)

    text = rendered_path.read_text(encoding="utf-8") if rendered_path.exists() else ""
    region = render_region(mark_stale(entries, by_id, config))
    updated = splice(text, region, config["render_marker"])
    if updated != text:
        rendered_path.write_text(updated, encoding="utf-8")
        print(f"wrote {rendered_path}")

    moved = "" if score == blind["score"] else f"（盲判 {blind['score']}/4 → 複審 {score}/4）"
    print(f"reviewed id {card.case_id}: {args.disposition}{moved}")
    return 0


def _preview(cards: list[Card]) -> int:
    blocked = [card for card in cards if card.blocked]
    for card in cards:
        if card.blocked:
            continue
        print(f"\nid {card.case_id} · {card.genre}\n")
        for index, span in enumerate(card.spans):
            if index:
                print("  ——")
            for line in span.split("\n"):
                print(f"  {line}")
    print(f"\n可呈現 {len(cards) - len(blocked)} 案，needs-manual {len(blocked)} 案。")
    for card in blocked:
        print(f"  needs-manual id {card.case_id}：{card.blocked}")
    return 0


def _render_only(
    args: argparse.Namespace, config: dict, rendered_path: Path, entries: list[dict]
) -> int:
    existing = rendered_path.read_text(encoding="utf-8") if rendered_path.exists() else ""
    updated = splice(existing, render_region(entries), config["render_marker"])
    if args.check:
        if updated != existing:
            print(f"{rendered_path}: 生成區與帳本不同步——跑 --render")
            return 1
        print(f"{rendered_path}: 生成區與帳本同步")
        return 0
    if updated != existing:
        rendered_path.write_text(updated, encoding="utf-8")
        print(f"wrote {rendered_path}")
    else:
        print(f"{rendered_path}: 無變動")
    return 0


def _session(
    args: argparse.Namespace,
    config: dict,
    cards: list[Card],
    by_id: dict[int, dict],
    skill_dir: Path,
    ledger_path: Path,
    rendered_path: Path,
    entries: list[dict],
) -> int:
    if not sys.stdin.isatty():
        raise AnnotateError(
            "互動判讀需要 tty；管線呼叫會把 EOF 當成離開，看起來像跑完一輪空 sweep。"
            "要非互動檢視請用 --preview"
        )

    classes = key_classes(skill_dir) if config["verdict_class_from"] else {}
    na_map = ai_index_na(skill_dir) if config["verdict_class_from"] else {}
    judged = by_pass(entries, BLIND)
    blocked = [card for card in cards if card.blocked]
    queue = [
        card
        for card in cards
        if not card.blocked and (args.redo or card.case_id not in judged)
    ]

    seen_digests: dict[str, int] = {}
    answered: list[int] = []
    stopped = False
    try:
        for index, card in enumerate(queue, start=1):
            digest = span_digest(card.spans)
            twin = seen_digests.get(digest)
            if twin is not None:
                print(
                    f"注意：id {card.case_id} 的引文與 id {twin} 逐字相同"
                    "（fixture 裡的重複，不是錯誤）——同一段問兩次，答案不一致會看起來像訊號。",
                    file=sys.stderr,
                )
            seen_digests.setdefault(digest, card.case_id)

            outcome = ask(card, f"[{index}/{len(queue)}]")
            if outcome == "q":
                stopped = True
                break
            if outcome == "s":
                continue
            score, rationale = outcome
            klass, basis = classes.get(card.case_id, (None, "unavailable"))
            na_reason = na_map.get(card.case_id)
            entry = {
                "case_id": card.case_id,
                "score": score,
                "rationale": rationale,
                "date": date.today().isoformat(),
                "genre": card.genre,
                "spans": list(card.spans),
                "span_sha256": digest,
                "key_class": klass,
                "key_class_basis": basis,
                "contradicts_key": None if na_reason else contradicts(score, klass),
                "superseded_by": None,
            }
            if na_reason:
                entry["ai_index_na"] = na_reason
            entry["pass"] = BLIND
            # BLIND-scoped like _record's filter: an interactive --redo re-runs
            # the blind pass and must not eat a review already on the books.
            entries = [
                e
                for e in entries
                if not (e["case_id"] == card.case_id and entry_pass(e) == BLIND)
            ] + [entry]
            save_ledger(ledger_path, args.skill, entries)
            answered.append(card.case_id)
    except (KeyboardInterrupt, EOFError):
        stopped = True
        print(file=sys.stderr)

    existing = rendered_path.read_text(encoding="utf-8") if rendered_path.exists() else ""
    region = render_region(mark_stale(entries, by_id, config))
    updated = splice(existing, region, config["render_marker"])
    if updated != existing:
        rendered_path.write_text(updated, encoding="utf-8")
        print(f"wrote {rendered_path}")

    print(f"本次判讀 {len(answered)} 案：{answered}" if answered else "本次未判讀任何案。")
    conflicting = sorted(e["case_id"] for e in entries if e.get("contradicts_key") is True)
    if conflicting:
        print(f"與 key 相左：{conflicting}")
    undecidable = sorted(
        e["case_id"] for e in entries if e.get("key_class") is None and e.get("key_class_basis") != "unavailable"
    )
    if undecidable:
        print(f"無法判定 key 類別：{undecidable}")
    if blocked:
        print(f"needs-manual（未呈現）：{sorted(c.case_id for c in blocked)}")
    if stopped:
        remaining = [
            card.case_id
            for card in queue
            if card.case_id not in answered and card.case_id not in judged
        ]
        if remaining:
            spec = ",".join(str(i) for i in remaining)
            print(
                f"下次接續：uv run tools/annotate {args.skill} --ids {spec}",
                file=sys.stderr,
            )
    return 0


def cli(argv: list[str]) -> int:
    try:
        return main(argv)
    except ScoreEvalsError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(cli(sys.argv[1:]))
