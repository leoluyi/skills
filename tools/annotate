CARD_INSTRUCTION = (
    "［以下逐字呈現給作者］不得增刪改寫、不得摘要、不得補充評語——"
    "盲判保護的是作者看到什麼，agent 只是轉貼管道。"
)


def _card(args: argparse.Namespace, config: dict, by_id: dict[int, dict], entries: list[dict]) -> int:
    """Print one case's card for an agent to relay verbatim, then stop.

    This and --record are the only non-interactive doors into the tool: an
    agent (Claude Code, Codex, any chat UI) can drive a judging session by
    shelling out to --card, pasting the card portion unmodified, collecting
    the author's own score and rationale through its own UI as two separate
    questions, and then shelling out to --record. The question protocol ships
    with the card rather than living in a doc the agent may never read: a
    combined score-and-rationale prompt, or a reordered scale, changes what
    the ledger's numbers mean, and nothing downstream can detect that it
    happened. The tool stays the single source of truth for extraction,
    the leak gates, class derivation, and the marker splice; the agent is a
    dumb pipe between two subprocess calls, never a party that reads
    evals.json or writes a rationale on the author's behalf.
    """
    case = by_id.get(args.card)
    if case is None:
        raise AnnotateError(f"no such case id in the fixture: {args.card}")
    card = build_card(case, config)
    if card.blocked:
        print(f"needs-manual id {card.case_id}：{card.blocked}", file=sys.stderr)
        return 2
    judged = set(by_pass(entries, BLIND))
    if card.case_id in judged and not args.redo:
        print(
            f"注意：id {card.case_id} 已在 ledger 裡有判讀；--record 若沒加 --redo 會被拒絕。",
            file=sys.stderr,
        )
    print(AGENT_PROTOCOL)
    print(f"\n{CARD_INSTRUCTION}")
    print(f"\nid {card.case_id} · {card.genre}\n")
    for index, span in enumerate(card.spans):
        if index:
            print("  ——")
        for line in span.split("\n"):
            print(f"  {line}")
    # The anchors ship with the card, not just with the interactive loop: an
    # agent relaying this to the author is the only place the author sees them,
    # and an unanchored 1-4 drifts across a multi-session sweep.
    print(f"\nAI 指數？\n{SCALE_HELP}")
    return 0


def _record(
    args: argparse.Namespace,
    config: dict,
    by_id: dict[int, dict],
    skill_dir: Path,
    ledger_path: Path,
    rendered_path: Path,
    entries: list[dict],
) -> int:
    """Record one verdict non-interactively, then re-render.

    Re-derives the card rather than trusting the caller's last --card output,
    so a case that was presentable when --card ran but has since gone stale
    (or was never valid) cannot be recorded through this door either.
    """
    case = by_id.get(args.record)
    if case is None:
        raise AnnotateError(f"no such case id in the fixture: {args.record}")
    card = build_card(case, config)
    if card.blocked:
        raise AnnotateError(f"case {card.case_id} is needs-manual: {card.blocked}")
    rationale = (args.rationale or "").strip()
    if not rationale and rationale_required(args.score):
        raise AnnotateError(
            f"AI 指數 {args.score} 需要 --rationale：指向 AI 的判讀要說出看到什麼，"
            "1 與 2 才可留空"
        )

    judged = by_pass(entries, BLIND)
    if card.case_id in judged and not args.redo:
        raise AnnotateError(
            f"case {card.case_id} already has a verdict in the ledger; pass --redo to overwrite it"
        )

    classes = key_classes(skill_dir) if config["verdict_class_from"] else {}
    klass, basis = classes.get(card.case_id, (None, "unavailable"))
    na_reason = (ai_index_na(skill_dir) if config["verdict_class_from"] else {}).get(card.case_id)
    digest = span_digest(card.spans)
    entry = {
        "case_id": card.case_id,
        "score": args.score,
        "rationale": rationale,
        "date": date.today().isoformat(),
        "genre": card.genre,
        "spans": list(card.spans),
        "span_sha256": digest,
        "key_class": klass,
        "key_class_basis": basis,
        "contradicts_key": None if na_reason else contradicts(args.score, klass),
        "pass": BLIND,
        "superseded_by": None,
    }
    if na_reason:
        entry["ai_index_na"] = na_reason
    # Replaces the blind entry only. A --redo here re-runs the blind pass; any
    # review already recorded against this case survives, and its own
    # superseded_by pointer keeps saying which verdict it answered.
    entries = [
        e for e in entries if not (e["case_id"] == card.case_id and entry_pass(e) == BLIND)
    ] + [entry]
    save_ledger(ledger_path, args.skill, entries)

    existing = rendered_path.read_text(encoding="utf-8") if rendered_path.exists() else ""
    region = render_region(mark_stale(entries, by_id, config))
    updated = splice(existing, region, config["render_marker"])
    if updated != existing:
        rendered_path.write_text(updated, encoding="utf-8")
        print(f"wrote {rendered_path}")

    print(f"recorded id {card.case_id}: {args.score}/4（{SCALE[args.score]}）")
    if entry["contradicts_key"] is True:
        print(f"與 key 相左：id {card.case_id} 屬 {klass} 類")
    return 0


