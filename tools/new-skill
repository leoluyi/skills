#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $(basename "$0") <kebab-case-name>" >&2
  exit 1
fi

NAME="$1"
if [[ ! "$NAME" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]]; then
  echo "error: name must be kebab-case (lowercase letters/digits, hyphen-separated)" >&2
  exit 1
fi

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SKILL_DIR="$REPO_ROOT/skills/$NAME"
EVAL_DIR="$SKILL_DIR/evals"
AGENTS_DIR="$SKILL_DIR/agents"

if [[ -e "$SKILL_DIR" ]]; then
  echo "error: $SKILL_DIR already exists" >&2
  exit 1
fi
if [[ -e "$EVAL_DIR" ]]; then
  echo "error: $EVAL_DIR already exists" >&2
  exit 1
fi

mkdir -p "$SKILL_DIR" "$EVAL_DIR" "$AGENTS_DIR"

cat > "$SKILL_DIR/SKILL.md" <<EOF
---
name: $NAME
description: [TODO: one-sentence trigger — be pushy and specific. Name the explicit phrases / contexts that should fire this skill, and what should NOT fire it.]
version: 0.1.0
license: MIT
compatibility: Any AI coding assistant that supports agentskills.io SKILL.md format (Claude Code, Cursor, VS Code Copilot, Hermes Agent, OpenHands, etc.) or OpenClaw. No external tools or APIs required.
metadata:
  author: Lu Yi
  tags: [TODO: space-separated tags — e.g. writing zh-tw traditional-chinese]
  agentskills_spec: "1.0"
  openclaw:
    emoji: "[TODO: one emoji, e.g. ✍️]"
---

# $NAME

[TODO: one-line purpose.]

## When to use

- Use when [TODO]
- Skip when [TODO]

## Procedure

1. [TODO: imperative step]
2. [TODO: imperative step]

## Why

[TODO: explain the reasoning so a reader can extrapolate to edge cases the bullets miss.]
EOF

cat > "$EVAL_DIR/evals.json" <<EOF
{
  "skill_name": "$NAME",
  "evals": [
    {
      "id": 1,
      "prompt": "[TODO: realistic prompt]",
      "expected_output": "[TODO: human-readable description of success]",
      "expectations": ["[TODO: an objectively verifiable statement]"]
    }
  ]
}
EOF

cat > "$EVAL_DIR/trigger-queries.json" <<EOF
{
  "skill_name": "$NAME",
  "queries": [
    {
      "id": 1,
      "query": "[TODO: realistic user message that SHOULD fire this skill]",
      "should_trigger": true,
      "category": "positive/[TODO]"
    },
    {
      "id": 2,
      "query": "[TODO: lookalike message that must NOT fire it]",
      "should_trigger": false,
      "category": "negative/[TODO]",
      "note": "[TODO: why this must not trigger]"
    }
  ]
}
EOF

cat > "$EVAL_DIR/config.json" <<EOF
{
  "profile": "standard",
  "quick_ids": [1]
}
EOF

# Codex-side metadata. Scaffolded model-invoked: no `policy` block, so
# `allow_implicit_invocation` stays at its default of true. To make the skill
# user-invoked, set `disable-model-invocation: true` in SKILL.md AND uncomment
# the policy block below — one without the other still auto-fires on the
# harness that was missed. 'tools/check-invocation' enforces the pairing.
cat > "$AGENTS_DIR/openai.yaml" <<EOF
interface:
  display_name: "[TODO: human-readable title for the Codex skill picker]"
  short_description: >-
    [TODO: one-line summary a person browsing the picker can act on.]
# policy:
#   allow_implicit_invocation: false
EOF

echo "created:"
echo "  $SKILL_DIR/SKILL.md"
echo "  $AGENTS_DIR/openai.yaml"
echo "  $EVAL_DIR/evals.json"
echo "  $EVAL_DIR/trigger-queries.json"
echo "  $EVAL_DIR/config.json"
echo
echo "next steps:"
echo "  1. fill in the SKILL.md frontmatter: description (the trigger gate), tags, and openclaw emoji,"
echo "     then agents/openai.yaml (invocation mode + picker text; check with 'tools/check-invocation $NAME')"
echo "  2. write the body (under 500 lines; references/ + scripts/ for the rest)"
echo "  3. add at least three realistic prompts to skills/$NAME/evals/evals.json,"
echo "     update evals/config.json for quick_ids / critical_expectations when needed,"
echo "     and flesh out evals/trigger-queries.json (then run 'tools/eval validate $NAME')"
echo "  4. run 'tools/sync-skills' if airgapped, otherwise consumers pick it up via 'npx skills update --all'"
