#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""Check that a skill's invocation mode is declared the same way in both harnesses.

A skill is user-invoked in Claude Code through ``disable-model-invocation: true``
in the ``SKILL.md`` frontmatter, and in Codex through
``policy.allow_implicit_invocation: false`` in ``agents/openai.yaml``. Neither
harness reads the other's field, so a skill declared on one side and not the
other still auto-fires on the side that was missed — silently, and exactly for
the skills whose whole point is that they never fire on their own.

That is what this gate catches, and it is why it is a hard failure rather than
a warning: the two files contradict each other, which is objective and readable
straight off disk. Nothing here judges *which* mode a skill should be in.

Three checks, in order:

1. Every skill ships ``agents/openai.yaml``.
2. It declares ``interface.display_name`` and ``interface.short_description``
   — the Codex skill picker shows the first and has nothing to fall back to.
3. Its invocation mode agrees with ``SKILL.md``. Both defaults are the
   permissive one: an absent ``disable-model-invocation`` means model-invoked,
   and an absent ``allow_implicit_invocation`` means the same, so a file that
   simply omits the ``policy`` block is a correct model-invoked declaration
   rather than an incomplete one.

Unknown keys are left alone: ``agents/openai.yaml`` follows a schema this repo
does not own, and failing on a field OpenAI added last week would make the gate
wrong more often than the drift it guards.

Read-only.

Usage:
  uv run tools/check-invocation <skill>   # one skill
  uv run tools/check-invocation --all     # every skill under skills/
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

import yaml

FRONTMATTER_RE = re.compile(r"^---\n(.*?)\n---\n", re.S)
CODEX_CONFIG = Path("agents") / "openai.yaml"


class SkillError(Exception):
    """Raised when a file that must exist cannot be read or parsed."""


def load_frontmatter(skill_dir: Path) -> dict:
    path = skill_dir / "SKILL.md"
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise SkillError(f"cannot read {path}: {exc}") from exc
    match = FRONTMATTER_RE.match(text)
    if not match:
        raise SkillError(f"{path}: no YAML frontmatter block")
    try:
        data = yaml.safe_load(match.group(1))
    except yaml.YAMLError as exc:
        raise SkillError(f"{path}: {exc}") from exc
    if not isinstance(data, dict):
        raise SkillError(f"{path}: frontmatter must be a mapping")
    return data


def load_codex_config(skill_dir: Path) -> dict:
    path = skill_dir / CODEX_CONFIG
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise SkillError(f"cannot read {path}: {exc}") from exc
    except yaml.YAMLError as exc:
        raise SkillError(f"{path}: {exc}") from exc
    if not isinstance(data, dict):
        raise SkillError(f"{path}: top level must be a mapping")
    return data


def check_skill(skill_dir: Path) -> list[str]:
    frontmatter = load_frontmatter(skill_dir)
    config = load_codex_config(skill_dir)
    failures: list[str] = []

    interface = config.get("interface")
    if not isinstance(interface, dict):
        failures.append(f"{CODEX_CONFIG}: 'interface' must be a mapping")
        interface = {}
    for key in ("display_name", "short_description"):
        value = interface.get(key)
        if not isinstance(value, str) or not value.strip():
            failures.append(
                f"{CODEX_CONFIG}: interface.{key} is required and must be "
                "a non-empty string"
            )

    policy = config.get("policy", {})
    if not isinstance(policy, dict):
        failures.append(f"{CODEX_CONFIG}: 'policy' must be a mapping")
        policy = {}
    implicit = policy.get("allow_implicit_invocation", True)
    if not isinstance(implicit, bool):
        failures.append(
            f"{CODEX_CONFIG}: policy.allow_implicit_invocation must be a "
            f"boolean, got {implicit!r}"
        )
        return failures

    disable = frontmatter.get("disable-model-invocation", False)
    if not isinstance(disable, bool):
        failures.append(
            "SKILL.md: disable-model-invocation must be a boolean, "
            f"got {disable!r}"
        )
        return failures

    if disable is not (implicit is False):
        failures.append(
            "harnesses disagree on invocation mode — SKILL.md says "
            f"disable-model-invocation: {disable}, {CODEX_CONFIG} says "
            f"allow_implicit_invocation: {implicit}. Set both or neither."
        )
    return failures


def mode_label(skill_dir: Path) -> str:
    disable = load_frontmatter(skill_dir).get("disable-model-invocation", False)
    return "user-invoked" if disable else "model-invoked"


def run_one(name: str, skill_dir: Path) -> tuple[int, list[str]]:
    """Check one skill, print its one-line verdict, and return (code, failures)."""
    if not (skill_dir / CODEX_CONFIG).exists():
        print(f"{name}: missing {CODEX_CONFIG}")
        return 1, [f"{name}: missing {CODEX_CONFIG} — every skill carries one"]

    try:
        failures = check_skill(skill_dir)
    except SkillError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2, []

    if failures:
        print(f"{name}: {len(failures)} problem(s)")
        return 1, [f"{name}: {line}" for line in failures]

    print(f"{name}: {mode_label(skill_dir)} in both harnesses")
    return 0, []


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "skill", nargs="?", help="skill slug under skills/; omit with --all"
    )
    parser.add_argument(
        "--all", action="store_true", help="check every skill under skills/"
    )
    args = parser.parse_args()
    if bool(args.skill) == args.all:
        parser.error("give a skill slug or --all, not both or neither")

    skills_root = Path(__file__).resolve().parent.parent / "skills"

    if args.skill:
        skill_dir = skills_root / args.skill
        if not (skill_dir / "SKILL.md").exists():
            print(f"no such skill: {skill_dir}", file=sys.stderr)
            return 2
        targets = [(args.skill, skill_dir)]
    else:
        targets = [
            (path.parent.name, path.parent)
            for path in sorted(skills_root.glob("*/SKILL.md"))
        ]

    worst, all_failures = 0, []
    for name, skill_dir in targets:
        code, failures = run_one(name, skill_dir)
        worst = max(worst, code)
        all_failures.extend(failures)

    if all_failures:
        print()
        for line in all_failures:
            print(f"FAIL {line}")
        print(f"\n{len(all_failures)} problem(s)")
    return worst


if __name__ == "__main__":
    sys.exit(main())
