#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml", "markdown"]
# ///
"""Generate docs/index.html, docs/skills.json, docs/guide/<slug>/index.html,
and the README catalog tables and skill-count badges from skills/<slug>/catalog.md
+ skills/<slug>/guide.{en,zh}.md + docs/catalog.yml.

skills/<slug>/catalog.md (front matter only) is the single source of truth
for a skill's public-facing 說明. skills/<slug>/guide.en.md / guide.zh.md are
the optional reader-facing deep-dive pages. Nothing else should be hand-edited
for a routine catalog update — see .agents/writing-docs.md.

Usage:
  uv run tools/build-docs           # write docs/index.html, docs/skills.json,
                                     # docs/guide/<slug>/index.html, and the
                                     # catalog sections + badges of both READMEs
  uv run tools/build-docs --check   # write nothing; exit 1 if any of those would change
"""
from __future__ import annotations

import html
import json
import re
import sys
from pathlib import Path

import markdown
import yaml

REPO = Path(__file__).resolve().parent.parent
SKILLS_DIR = REPO / "skills"
DOCS_DIR = REPO / "docs"
CATALOG_YML = DOCS_DIR / "catalog.yml"
TEMPLATE = DOCS_DIR / "index.template.html"
GUIDE_TEMPLATE = DOCS_DIR / "guide.template.html"
GUIDE_DIR = DOCS_DIR / "guide"
MD_EXTENSIONS = ["tables", "fenced_code", "attr_list"]
H1_RE = re.compile(r"^#\s+.*\n+")

LANG_BADGE = {"en": "EN", "zh-TW": "繁中", "mixed": "中英"}
BILINGUAL_FIELDS = ("title", "tagline", "whenUse", "whenNot")
MARKER_RE = {
    "en": re.compile(r"(<!-- CATALOG:START -->\n).*?(\n<!-- CATALOG:END -->)", re.S),
    "zh": re.compile(r"(<!-- CATALOG:START -->\n).*?(\n<!-- CATALOG:END -->)", re.S),
}
BADGE_RE = re.compile(r"(badge/skills-)\d+(-)")


def split_frontmatter(text: str) -> dict:
    m = re.match(r"^---\n(.*?)\n---\n?", text, re.S)
    if not m:
        raise ValueError("missing frontmatter block")
    return yaml.safe_load(m.group(1)) or {}


def load_skill(catalog_path: Path) -> dict:
    slug = catalog_path.parent.name
    data = split_frontmatter(catalog_path.read_text(encoding="utf-8"))

    for field in BILINGUAL_FIELDS:
        val = data.get(field)
        if not isinstance(val, dict) or "en" not in val or "zh" not in val:
            raise ValueError(f"{slug}: field '{field}' needs both en and zh")
    hl = data.get("highlights")
    if not isinstance(hl, dict) or "en" not in hl or "zh" not in hl:
        raise ValueError(f"{slug}: 'highlights' needs both en and zh lists")

    skill_md = catalog_path.parent / "SKILL.md"
    fm = split_frontmatter(skill_md.read_text(encoding="utf-8"))
    invoke_only = bool(fm.get("disable-model-invocation", False))

    guide_en = catalog_path.parent / "guide.en.md"
    guide_zh = catalog_path.parent / "guide.zh.md"
    has_guide = guide_en.exists() and guide_zh.exists()

    return {
        "slug": slug,
        "emoji": data["emoji"],
        "category": data["category"],
        "order": data.get("order", 0),
        "languages": data["languages"],
        "invokeOnly": invoke_only,
        "invocation": "user" if invoke_only else "model",
        "tags": data["tags"],
        "title": data["title"],
        "tagline": data["tagline"],
        "whenUse": data["whenUse"],
        "whenNot": data["whenNot"],
        "highlights": data["highlights"],
        "skillUrl": f"https://github.com/leoluyi/skills/blob/main/skills/{slug}/SKILL.md",
        "hasGuide": has_guide,
        "guideUrl": f"https://leoluyi.tw/skills/guide/{slug}/" if has_guide else None,
        "guidePaths": {"en": guide_en, "zh": guide_zh} if has_guide else None,
    }


def load_catalog() -> tuple[dict, list[dict], list[dict]]:
    cat_doc = yaml.safe_load(CATALOG_YML.read_text(encoding="utf-8"))
    site = cat_doc["site"]
    categories = cat_doc["categories"]
    cat_keys = {c["key"] for c in categories}

    skills = []
    for catalog_path in sorted(SKILLS_DIR.glob("*/catalog.md")):
        skill = load_skill(catalog_path)
        if skill["category"] not in cat_keys:
            raise ValueError(f"{skill['slug']}: unknown category '{skill['category']}'")
        skills.append(skill)
    skills.sort(key=lambda s: (
        [c["key"] for c in categories].index(s["category"]),
        s["order"],
        s["slug"],
    ))
    return site, categories, skills


# ---- skills.json -----------------------------------------------------------

def build_skills_json(site: dict, categories: list[dict], skills: list[dict]) -> str:
    out_categories = []
    for cat in categories:
        slugs = [s["slug"] for s in skills if s["category"] == cat["key"]]
        out_categories.append({
            "key": cat["key"],
            "label": cat["label"],
            "blurb": cat["blurb"],
            "slugs": slugs,
        })
    out_skills = []
    for s in sorted(skills, key=lambda s: s["slug"]):
        out_skills.append({
            "slug": s["slug"],
            "emoji": s["emoji"],
            "category": s["category"],
            "languages": s["languages"],
            "invokeOnly": s["invokeOnly"],
            "invocation": s["invocation"],
            "tags": s["tags"],
            "title": s["title"],
            "tagline": s["tagline"],
            "whenUse": s["whenUse"],
            "whenNot": s["whenNot"],
            "highlights": s["highlights"],
            "skillUrl": s["skillUrl"],
            "guideUrl": s["guideUrl"],
        })
    doc = {
        "name": site["name"],
        "repo": site["repo"],
        "site": site["site"],
        "count": len(skills),
        "categories": out_categories,
        "skills": out_skills,
    }
    return json.dumps(doc, ensure_ascii=False, indent=2) + "\n"


# ---- index.html --------------------------------------------------------

def search_text(s: dict) -> str:
    inv_slug = "user-invoked" if s["invocation"] == "user" else "model-invoked"
    parts = [s["slug"], s["title"]["en"], s["title"]["zh"],
              s["tagline"]["en"], s["tagline"]["zh"], inv_slug, *s["tags"]]
    return html.escape(" ".join(parts).lower(), quote=True)


def render_badges(s: dict) -> str:
    badges = "".join(f'<span class="badge lang">{LANG_BADGE[lang]}</span>' for lang in s["languages"])
    if s["invocation"] == "user":
        badges += ('<span class="badge inv inv-user"><span class="l-en">User-invoked</span>'
                   '<span class="l-zh">使用者叫用</span></span>')
    else:
        badges += ('<span class="badge inv inv-model"><span class="l-en">Model-invoked</span>'
                   '<span class="l-zh">模型叫用</span></span>')
    return badges


def render_card(s: dict) -> str:
    e = lambda t: html.escape(t, quote=False)
    li = "".join(
        f'        <li><span class="l-en">{e(en)}</span><span class="l-zh">{e(zh)}</span></li>\n'
        for en, zh in zip(s["highlights"]["en"], s["highlights"]["zh"])
    )
    tags = "".join(f'<span class="tag">#{e(t)}</span>' for t in s["tags"])
    guide_link = (
        f'          <a href="guide/{s["slug"]}/"><span class="l-en">Read the guide</span>'
        f'<span class="l-zh">看說明</span> &rarr;</a>'
        if s["hasGuide"] else ""
    )
    return f"""      <article class="card" data-cat="{s['category']}" data-inv="{s['invocation']}" data-search="{search_text(s)}">
        <div class="card-top">
          <div class="emoji" aria-hidden="true">{s['emoji']}</div>
          <div>
            <h3 class="card-title"><span class="l-en">{e(s['title']['en'])}</span><span class="l-zh">{e(s['title']['zh'])}</span>
              <code class="slug">{s['slug']}</code>
            </h3>
            <div class="badges">{render_badges(s)}</div>
          </div>
        </div>
        <p class="tagline"><span class="l-en">{e(s['tagline']['en'])}</span><span class="l-zh">{e(s['tagline']['zh'])}</span></p>
        <details>
          <summary><span class="l-en">What it does</span><span class="l-zh">細節</span></summary>
          <div class="detail-block">
            <h4><span class="l-en">When to use</span><span class="l-zh">何時使用</span></h4>
            <p><span class="l-en">{e(s['whenUse']['en'])}</span><span class="l-zh">{e(s['whenUse']['zh'])}</span></p>
            <h4><span class="l-en">When not to</span><span class="l-zh">何時不要</span></h4>
            <p><span class="l-en">{e(s['whenNot']['en'])}</span><span class="l-zh">{e(s['whenNot']['zh'])}</span></p>
            <h4><span class="l-en">Highlights</span><span class="l-zh">重點</span></h4>
            <ul>
{li.rstrip(chr(10))}
            </ul>
          </div>
        </details>
        <div class="tags">{tags}</div>
        <div class="card-foot">
          <a href="{s['skillUrl']}"><span class="l-en">Read SKILL.md</span><span class="l-zh">看 SKILL.md</span> &rarr;</a>
{guide_link}
        </div>
      </article>"""


def render_cards(categories: list[dict], skills: list[dict]) -> str:
    e = lambda t: html.escape(t, quote=False)
    sections = []
    for cat in categories:
        cat_skills = [s for s in skills if s["category"] == cat["key"]]
        if not cat_skills:
            continue
        cards = "\n".join(render_card(s) for s in cat_skills)
        sections.append(f"""    <section class="cat-group" data-cat="{cat['key']}">
      <h3 class="cat-title"><span class="dot" aria-hidden="true"></span><span class="l-en">{e(cat['label']['en'])}</span><span class="l-zh">{e(cat['label']['zh'])}</span></h3>
      <p class="cat-blurb"><span class="l-en">{e(cat['blurb']['en'])}</span><span class="l-zh">{e(cat['blurb']['zh'])}</span></p>
      <div class="grid">
{cards}
      </div>
    </section>""")
    return "\n".join(sections)


def render_filters(categories: list[dict], skills: list[dict]) -> str:
    e = lambda t: html.escape(t, quote=False)
    chips = [
        f'      <button class="chip" data-cat="all" aria-pressed="true">'
        f'<span class="l-en">All</span><span class="l-zh">全部</span>'
        f'<span class="count">{len(skills)}</span></button>'
    ]
    for cat in categories:
        count = sum(1 for s in skills if s["category"] == cat["key"])
        chips.append(
            f'      <button class="chip" data-cat="{cat["key"]}" aria-pressed="false">'
            f'<span class="l-en">{e(cat["label"]["en"])}</span>'
            f'<span class="l-zh">{e(cat["label"]["zh"])}</span>'
            f'<span class="count">{count}</span></button>'
        )
    cat_filters = (
        '      <div class="filters" data-group="cat" role="group" aria-label="Filter by category">\n'
        + "\n".join(chips) + "\n      </div>"
    )

    user_count = sum(1 for s in skills if s["invocation"] == "user")
    model_count = len(skills) - user_count
    inv_chips = [
        f'      <button class="chip" data-inv="all" aria-pressed="true">'
        f'<span class="l-en">All</span><span class="l-zh">全部</span>'
        f'<span class="count">{len(skills)}</span></button>',
        f'      <button class="chip" data-inv="user" aria-pressed="false">'
        f'<span class="l-en">User-invoked</span><span class="l-zh">使用者叫用</span>'
        f'<span class="count">{user_count}</span></button>',
        f'      <button class="chip" data-inv="model" aria-pressed="false">'
        f'<span class="l-en">Model-invoked</span><span class="l-zh">模型叫用</span>'
        f'<span class="count">{model_count}</span></button>',
    ]
    inv_filters = (
        '      <div class="filters" data-group="inv" role="group" aria-label="Filter by invocation">\n'
        + "\n".join(inv_chips) + "\n      </div>"
    )
    return cat_filters + "\n" + inv_filters


def render_itemlist(skills: list[dict]) -> str:
    items = []
    for i, s in enumerate(sorted(skills, key=lambda s: s["slug"]), 1):
        items.append({
            "@type": "ListItem",
            "position": i,
            "item": {
                "@type": "CreativeWork",
                "name": s["title"]["en"],
                "description": s["tagline"]["en"],
                "url": s["skillUrl"],
                "keywords": ", ".join(s["tags"]),
            },
        })
    return json.dumps(items, ensure_ascii=False, indent=2)


def build_index_html(categories: list[dict], skills: list[dict]) -> str:
    tpl = TEMPLATE.read_text(encoding="utf-8")
    tpl = tpl.replace("__SKILL_COUNT__", str(len(skills)))
    tpl = tpl.replace("__CATEGORY_COUNT__", str(len(categories)))
    tpl = tpl.replace("__ITEMLIST_JSON__", render_itemlist(skills))
    tpl = tpl.replace("__CATALOG_FILTERS__", render_filters(categories, skills))
    tpl = tpl.replace("__CATALOG_CARDS__", render_cards(categories, skills))
    return tpl


# ---- guide pages (docs/guide/<slug>/index.html) -----------------------------

def render_sidebar(categories: list[dict], skills: list[dict], current_slug: str) -> str:
    e = lambda t: html.escape(t, quote=False)
    groups = []
    for cat in categories:
        cat_skills = [s for s in skills if s["category"] == cat["key"] and s["hasGuide"]]
        if not cat_skills:
            continue
        items = "\n".join(
            (lambda cur: (
                f'        <li><a href="../{s["slug"]}/"{cur}>'
                f'<span class="l-en">{e(s["title"]["en"])}</span>'
                f'<span class="l-zh">{e(s["title"]["zh"])}</span></a></li>'
            ))(' aria-current="page" class="current"' if s["slug"] == current_slug else "")
            for s in cat_skills
        )
        groups.append(
            f'      <div class="side-group">\n'
            f'        <h4><span class="l-en">{e(cat["label"]["en"])}</span>'
            f'<span class="l-zh">{e(cat["label"]["zh"])}</span></h4>\n'
            f'        <ul>\n{items}\n        </ul>\n'
            f'      </div>'
        )
    return "\n".join(groups)


def render_prev_next(skills_with_guides: list[dict], current_slug: str) -> str:
    e = lambda t: html.escape(t, quote=False)
    idx = next(i for i, s in enumerate(skills_with_guides) if s["slug"] == current_slug)
    prev_s = skills_with_guides[idx - 1] if idx > 0 else None
    next_s = skills_with_guides[idx + 1] if idx < len(skills_with_guides) - 1 else None

    def link(s, label_en, label_zh, cls):
        if not s:
            return f'<span class="page-nav-empty"></span>'
        return (
            f'<a class="page-nav-link {cls}" href="../{s["slug"]}/">'
            f'<span class="page-nav-dir"><span class="l-en">{label_en}</span><span class="l-zh">{label_zh}</span></span>'
            f'<span class="page-nav-title"><span class="l-en">{e(s["title"]["en"])}</span>'
            f'<span class="l-zh">{e(s["title"]["zh"])}</span></span></a>'
        )

    return (
        '    <nav class="page-nav">\n'
        f'      {link(prev_s, "← Previous", "← 上一篇", "prev")}\n'
        f'      {link(next_s, "Next →", "下一篇 →", "next")}\n'
        '    </nav>'
    )


def render_guide_body(path: Path) -> str:
    """Render a guide.*.md file, dropping its leading H1 (the page already
    renders the title from catalog.md in the guide-head chrome)."""
    text = H1_RE.sub("", path.read_text(encoding="utf-8"), count=1)
    return markdown.markdown(text, extensions=MD_EXTENSIONS)


def build_guide_html(categories: list[dict], skills: list[dict], s: dict, guides_ordered: list[dict]) -> str:
    tpl = GUIDE_TEMPLATE.read_text(encoding="utf-8")
    body_en = render_guide_body(s["guidePaths"]["en"])
    body_zh = render_guide_body(s["guidePaths"]["zh"])
    e = lambda t: html.escape(t, quote=True)
    tpl = tpl.replace("__TITLE_EN__", e(s["title"]["en"]))
    tpl = tpl.replace("__TITLE_ZH__", e(s["title"]["zh"]))
    tpl = tpl.replace("__TAGLINE_EN__", e(s["tagline"]["en"]))
    tpl = tpl.replace("__TAGLINE_ZH__", e(s["tagline"]["zh"]))
    tpl = tpl.replace("__SLUG__", s["slug"])
    tpl = tpl.replace("__BADGES__", render_badges(s))
    tpl = tpl.replace("__SKILL_URL__", s["skillUrl"])
    tpl = tpl.replace("__GUIDE_URL__", s["guideUrl"])
    tpl = tpl.replace("__SIDEBAR__", render_sidebar(categories, skills, s["slug"]))
    tpl = tpl.replace("__PREV_NEXT__", render_prev_next(guides_ordered, s["slug"]))
    tpl = tpl.replace("__BODY_EN__", body_en)
    tpl = tpl.replace("__BODY_ZH__", body_zh)
    return tpl


def build_guide_pages(categories: list[dict], skills: list[dict]) -> dict[Path, str]:
    guides_ordered = [s for s in skills if s["hasGuide"]]
    return {
        GUIDE_DIR / s["slug"] / "index.html": build_guide_html(categories, skills, s, guides_ordered)
        for s in guides_ordered
    }


# ---- README catalog section ------------------------------------------------

def build_readme_section(lang: str, categories: list[dict], skills: list[dict]) -> str:
    heading = "## Skill catalog" if lang == "en" else "## 技能目錄"
    intro = (
        f"{len(skills)} skills across {len(categories)} categories. Every skill is labelled "
        "`model-invoked` (the agent fires it automatically on a matching task, and you can "
        "also call it by name) or `user-invoked` (only you can, by name). "
        "Browse the [interactive catalog ↗](https://leoluyi.tw/skills/) or read any "
        "[`SKILL.md`](skills/) directly."
        if lang == "en" else
        f"{len(skills)} 個技能、{len(categories)} 個分類。每個技能都標了叫用方式："
        "`model-invoked`（任務命中 trigger 時 agent 會自動載入，也能自己指名叫）"
        "或 `user-invoked`（只有你能指名叫）。可看[互動式目錄 ↗](https://leoluyi.tw/skills/)，"
        "或直接讀任何一份 [`SKILL.md`](skills/)。"
    )
    what_col = "What it does" if lang == "en" else "做什麼"
    inv_col = "Invocation" if lang == "en" else "叫用方式"

    blocks = [heading, "", intro]
    for cat in categories:
        cat_skills = [s for s in skills if s["category"] == cat["key"]]
        if not cat_skills:
            continue
        blocks.append("")
        blocks.append(f"### {cat['label'][lang if lang == 'en' else 'zh']}")
        note = cat.get("readmeNote")
        if note:
            blocks.append("")
            blocks.append(note[lang if lang == "en" else "zh"])
        blocks.append("")
        blocks.append(f"| Skill | {inv_col} | {what_col} |")
        blocks.append("|---|---|---|")
        for s in cat_skills:
            name = s["title"][lang if lang == "en" else "zh"]
            tagline = s["tagline"][lang if lang == "en" else "zh"]
            inv = "`user-invoked`" if s["invokeOnly"] else "`model-invoked`"
            blocks.append(
                f"| **{name}**<br>[`{s['slug']}`](skills/{s['slug']}/SKILL.md) | {inv} | {tagline} |"
            )
    return "\n".join(blocks)


def render_readme(text: str, label: str, lang: str, categories: list[dict], skills: list[dict]) -> str:
    """Return `text` with the catalog section and the skill-count badge refreshed."""
    section = build_readme_section(lang, categories, skills)
    text, n = MARKER_RE[lang].subn(lambda m: m.group(1) + section + m.group(2), text, count=1)
    if n != 1:
        raise ValueError(f"{label}: CATALOG markers not found")
    text, n = BADGE_RE.subn(lambda m: f"{m.group(1)}{len(skills)}{m.group(2)}", text, count=1)
    if n != 1:
        raise ValueError(f"{label}: skill-count badge (badge/skills-N-) not found")
    return text


def main() -> None:
    check_only = "--check" in sys.argv
    site, categories, skills = load_catalog()

    skills_json = build_skills_json(site, categories, skills)
    index_html = build_index_html(categories, skills)
    guide_pages = build_guide_pages(categories, skills)

    # Committed surfaces: --check always verifies these, since a stale one is a
    # real defect that would ship.
    tracked = {}
    for path, lang in ((REPO / "README.md", "en"), (REPO / "README.zh-TW.md", "zh")):
        tracked[path] = render_readme(
            path.read_text(encoding="utf-8"), path.name, lang, categories, skills
        )

    # Gitignored build output: absent on a fresh checkout and rebuilt by the Pages
    # workflow, so --check only compares them when they already exist locally.
    artifacts = {
        DOCS_DIR / "skills.json": skills_json,
        DOCS_DIR / "index.html": index_html,
        **guide_pages,
    }

    if check_only:
        stale = [p for p, content in tracked.items() if p.read_text(encoding="utf-8") != content]
        stale += [p for p, content in artifacts.items()
                  if p.exists() and p.read_text(encoding="utf-8") != content]
        if stale:
            print("out of date:", *[str(p) for p in stale], file=sys.stderr)
            sys.exit(1)
        return

    for path, content in {**artifacts, **tracked}.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")

    print(f"generated {len(skills)} skills across {len(categories)} categories, "
          f"{len(guide_pages)} guide pages")


if __name__ == "__main__":
    main()
