#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $(basename "$0") <skill-name>" >&2
  echo "       env: RUN_EVAL_AGENT=claude|codex to pin the router CLI (default: auto-detect)" >&2
  exit 1
fi

SKILL_NAME="$1"
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SKILL_MD="$REPO_ROOT/skills/$SKILL_NAME/SKILL.md"
# This harness tests description triggering only. Migrated skills keep their
# trigger queries beside the skill (skill-creator layout); the top-level
# evals/ tree is the legacy location for skills not yet migrated.
PROMPTS_FILE="$REPO_ROOT/skills/$SKILL_NAME/evals/trigger-queries.json"
if [ ! -f "$PROMPTS_FILE" ]; then
  PROMPTS_FILE="$REPO_ROOT/evals/$SKILL_NAME/prompts.json"
fi

command -v jq >/dev/null || { echo "error: jq required" >&2; exit 1; }
[[ -f "$SKILL_MD" ]]     || { echo "error: missing $SKILL_MD" >&2; exit 1; }
[[ -f "$PROMPTS_FILE" ]] || { echo "error: missing $PROMPTS_FILE" >&2; exit 1; }

# Extract description from YAML frontmatter. Handles both a single-line
# scalar (description: foo) and a folded/literal block scalar
# (description: >- / description: |-) whose body is the indented lines
# that follow, folded into one space-joined line per YAML folding rules.
DESCRIPTION=$(awk '
  /^---$/ {
    fence++
    if (fence == 2) { if (collecting) print out; exit }
    next
  }
  fence == 1 && !collecting && /^description:/ {
    val = $0
    sub(/^description:[[:space:]]*/, "", val)
    if (val ~ /^[>|][-+0-9]*[[:space:]]*$/) {
      collecting = 1
      out = ""
      next
    } else {
      print val
      exit
    }
  }
  fence == 1 && collecting {
    if ($0 ~ /^[[:space:]]/) {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      if (line == "") {
        out = out " "
      } else {
        if (out != "" && out !~ / $/) out = out " "
        out = out line
      }
      next
    } else {
      print out
      exit
    }
  }
' "$SKILL_MD")

[[ -n "$DESCRIPTION" ]] || { echo "error: no description in $SKILL_MD" >&2; exit 1; }

# The router runs as a one-shot subagent call through whatever coding-agent
# CLI is installed, never a direct HTTP call to a vendor's API. This keeps
# the harness cross-AI-company: it works with any CLI that supports a
# non-interactive/exec mode, not just Anthropic's.
AGENT="${RUN_EVAL_AGENT:-}"
if [[ -z "$AGENT" ]]; then
  if command -v claude >/dev/null 2>&1; then
    AGENT=claude
  elif command -v codex >/dev/null 2>&1; then
    AGENT=codex
  else
    echo "error: no supported coding-agent CLI found (need 'claude' or 'codex' on PATH)" >&2
    exit 1
  fi
fi
case "$AGENT" in
  claude|codex) ;;
  *) echo "error: unsupported RUN_EVAL_AGENT '$AGENT' (want claude or codex)" >&2; exit 1 ;;
esac

router_prompt() {
  local query="$1"
  cat <<EOF
You are a skill router. Decide whether the skill below should fire for the user message, using ONLY its description's stated trigger conditions and exclusions — be strict, follow the description verbatim.

Skill: $SKILL_NAME
Description: $DESCRIPTION

User message:
"""
$query
"""

Reply with exactly one word and nothing else: TRIGGER or NONE.
EOF
}

# Runs the router prompt as an isolated one-shot subagent call — no tool
# access, no file/network side effects, just a text judgment.
#
# Nested-session note: when this script runs from inside an already-running
# Claude Code session, the nested `claude -p` subprocess used to fail with
# "no parseable decision" and no visible cause. Root cause (confirmed
# 2026-07-28): if ANTHROPIC_API_KEY is set in the environment, the `claude`
# CLI prefers that metered billing-API path over the claude.ai CLI login —
# and in a dev/CI shell where that key is present but uncredited, every call
# silently fails. This tool only ever wants the free CLI-login router path
# (never a billed API call, and never Anthropic's HTTP API directly — see
# the cross-AI-company note above), so it explicitly drops the key for its
# own subprocess only; it does not touch the parent shell's environment.
invoke_router() {
  local query="$1" prompt raw
  prompt=$(router_prompt "$query")
  case "$AGENT" in
    claude)
      # stderr goes to its own file, never into $raw: merging it in (an
      # earlier version of this fix did `2>&1`) let a CLI error's stderr
      # text satisfy the same TRIGGER/NONE grep used to parse the real
      # answer — a stub CLI that errors while echoing the prompt back
      # (which contains the literal word "Trigger" from several skills'
      # own descriptions) produced a silently fabricated PASS. Keep stdout
      # and stderr on separate channels so a failure can only ever surface
      # as the "no parseable decision" diagnostic below, never as a verdict.
      local err_file
      err_file=$(mktemp)
      raw=$(env -u ANTHROPIC_API_KEY claude -p "$prompt" --tools="" </dev/null 2>"$err_file") || true
      if [[ -z "$raw" ]] || ! grep -qiwE 'TRIGGER|NONE' <<<"$raw"; then
        {
          echo "run-eval: claude -p produced no parseable TRIGGER/NONE decision."
          # Strip control bytes (raw ANSI/OSC sequences from a child CLI
          # shouldn't reach the caller's terminal) and redact anything
          # shaped like an API key before this ever prints to stderr.
          printf '  stderr: %.200s\n' \
            "$(LC_ALL=C tr -d '\000-\010\013\014\016-\037' <"$err_file" \
               | sed -E 's/sk-[A-Za-z0-9_-]+/<redacted>/g')"
          echo "  check: are you logged into claude.ai via the CLI ('claude /login')?"
        } >&2
      fi
      rm -f "$err_file"
      printf '%s' "$raw"
      ;;
    codex)
      # Pinned model + effort, with --ignore-user-config so the pin is
      # authoritative: $CODEX_HOME/config.toml can itself set `model` /
      # `model_reasoning_effort`, and without this flag those values win
      # over -m/-c silently — verified 2026-07-30 by passing a deliberately
      # invalid model name, which only errors with --ignore-user-config
      # present. Without pinning, a run today is not comparable to a run
      # next month, or even to a run on a different machine.
      #
      # -C "$REPO_ROOT": codex's trust check ("Not inside a trusted
      # directory...") is keyed to the working directory, and this script
      # computes REPO_ROOT but otherwise never cds into it — so invoking it
      # from outside the repo would fail on this branch only (the claude
      # branch has no such restriction). --skip-git-repo-check is kept as a
      # fallback for the separate case where REPO_ROOT itself is not a
      # trusted git checkout by codex's own accounting.
      #
      # `env -u OPENAI_API_KEY`: mirrors the claude branch's `-u
      # ANTHROPIC_API_KEY` for the same stated policy (never a billed API
      # call). Not reproduced as a live failure on this CLI/login mode —
      # a fake key did not get preferred over the active ChatGPT session —
      # but the cost of dropping it is zero and the failure mode, if it
      # exists on some auth configuration, would be silent.
      local tmp err_file
      tmp=$(mktemp)
      err_file=$(mktemp)
      env -u OPENAI_API_KEY codex exec -s read-only \
        -C "$REPO_ROOT" --skip-git-repo-check --ignore-user-config \
        -m gpt-5.6-luna -c model_reasoning_effort="xhigh" \
        -o "$tmp" "$prompt" </dev/null >/dev/null 2>"$err_file" || true
      raw=$(cat "$tmp" 2>/dev/null)
      # Same shape as the claude branch: never let stderr feed the verdict,
      # only the diagnostic. A benign local warning (this CLI logs a shell
      # snapshot validation failure on some machines) must not be mistaken
      # for the cause when $tmp is genuinely empty for another reason.
      if [[ -z "$raw" ]] || ! grep -qiwE 'TRIGGER|NONE' <<<"$raw"; then
        {
          echo "run-eval: codex exec produced no parseable TRIGGER/NONE decision."
          # Tail, not head: codex's own startup banner (version, workdir,
          # model, sandbox mode) runs 150-200+ bytes before any real error,
          # so a leading snippet reliably shows the banner and never the
          # failure. Verified 2026-07-30 against an invalid-model error.
          # Redact before slicing: a tail cut through the middle of a key would
          # strip the prefix the redaction matches on and print the remainder
          # verbatim.
          printf '  stderr: %s\n' \
            "$(LC_ALL=C tr -d '\000-\010\013\014\016-\037' <"$err_file" \
               | sed -E 's/sk-[A-Za-z0-9_-]+/<redacted>/g; s/ey[A-Za-z0-9_-]{20,}/<redacted>/g' \
               | tail -c 400)"
          echo "  check: is 'codex' authenticated, and is model 'gpt-5.6-luna' available to it?"
        } >&2
      fi
      rm -f "$tmp" "$err_file"
      printf '%s' "$raw"
      ;;
  esac
}

pass=0
fail=0
errors=0
fail_ids=()

while IFS= read -r entry; do
  id=$(jq -r '.id' <<<"$entry")
  category=$(jq -r '.category // "-"' <<<"$entry")
  query=$(jq -r '.prompt // .query' <<<"$entry")
  # Not `.expected_trigger // .should_trigger`: jq's `//` falls through on
  # `false` as well as `null`, so a fixture using the newer key would read
  # every negative case as `null` and FAIL it forever, silently.
  expected=$(jq -r 'if has("expected_trigger") then .expected_trigger else .should_trigger end' <<<"$entry")

  raw=$(invoke_router "$query")
  # Word-boundary match: a plain 'TRIGGER|NONE' substring match would also
  # hit "triggered" or "NoneType" inside an unrelated CLI message.
  choice=$(grep -ioE '\<TRIGGER\>|\<NONE\>' <<<"$raw" | head -1 | tr '[:upper:]' '[:lower:]' || true)

  if [[ -z "$choice" ]]; then
    printf "[%s] ERROR (%s) — no parseable decision from %s\n" "$id" "$category" "$AGENT" >&2
    errors=$((errors + 1))
    fail_ids+=("$id")
    continue
  fi

  actual=false
  [[ "$choice" == "trigger" ]] && actual=true

  if [[ "$actual" == "$expected" ]]; then
    printf "[%s] PASS  expected=%-5s actual=%-5s  %s\n" "$id" "$expected" "$actual" "$category"
    pass=$((pass + 1))
  else
    printf "[%s] FAIL  expected=%-5s actual=%-5s  %s\n" "$id" "$expected" "$actual" "$category"
    printf "       prompt: %.120s\n" "$query"
    fail=$((fail + 1))
    fail_ids+=("$id")
  fi
done < <(jq -c '(.queries // .evals)[]' "$PROMPTS_FILE")

total=$((pass + fail + errors))
echo "---"
printf "agent: %s   total: %d   pass: %d   fail: %d   error: %d\n" "$AGENT" "$total" "$pass" "$fail" "$errors"
if [[ ${#fail_ids[@]} -gt 0 ]]; then
  printf "failing ids: %s\n" "${fail_ids[*]}"
fi

[[ $fail -eq 0 && $errors -eq 0 ]]
