#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$REPO_ROOT/skills"

# --force/-f: replace real directories (non-symlinks) at the destination with
# per-skill symlinks instead of skipping them with a WARN. Destructive — the
# existing directory is removed, so only use it when this repo is the source of
# truth for those skills.
FORCE=0
for arg in "$@"; do
  case "$arg" in
    -f|--force) FORCE=1 ;;
    -h|--help)
      echo "usage: sync-skills [-f|--force]"
      echo "  -f, --force   replace real directories at the destination with symlinks"
      exit 0
      ;;
    *)
      echo "error: unknown argument: $arg" >&2
      echo "usage: sync-skills [-f|--force]" >&2
      exit 2
      ;;
  esac
done

# Per-tool skills trees to bridge. Each gets its own per-skill symlinks so this
# repo stays the single source of truth across tools:
#   ~/.claude/skills — Claude Code (also read by Cursor)
#   ~/.agents/skills — Codex, OpenHands, and the emerging cross-tool standard dir
# Codex/OpenHands do NOT read ~/.claude/skills, so the second tree is what makes
# a skill actually portable rather than Claude-Code-only. See README "Portability".
DESTS=(
  "${HOME}/.claude/skills"
  "${HOME}/.agents/skills"
)

if [[ ! -d "$SRC" ]]; then
  echo "error: $SRC does not exist" >&2
  exit 1
fi

shopt -s nullglob

sync_tree() {
  local dst="$1"
  mkdir -p "$dst"

  # Per-skill symlinks: avoids the Claude Code discovery bug where a
  # directory-level symlink at the tree root itself confuses the loader.
  local skill_path name target
  for skill_path in "$SRC"/*/; do
    skill_path="${skill_path%/}"
    name="$(basename "$skill_path")"
    target="$dst/$name"

    if [[ -L "$target" ]]; then
      ln -sfn "$skill_path" "$target"
      echo "linked: $dst/$name"
    elif [[ -e "$target" ]]; then
      if [[ "$FORCE" -eq 1 ]]; then
        rm -rf -- "$target"
        ln -s "$skill_path" "$target"
        echo "replaced (real dir): $dst/$name"
      else
        echo "WARN: $target is a real directory, not a symlink — skipping. Re-run with -f/--force to replace it, or remove/rename it manually." >&2
      fi
    else
      ln -s "$skill_path" "$target"
      echo "linked: $dst/$name"
    fi
  done

  # Prune dangling symlinks under dst (target no longer exists). Only touches
  # dangling symlinks — real dirs and valid links from other sources are left alone.
  local entry
  for entry in "$dst"/*; do
    if [[ -L "$entry" && ! -e "$entry" ]]; then
      rm -- "$entry"
      echo "pruned dangling: $dst/$(basename "$entry")"
    fi
  done
}

for dst in "${DESTS[@]}"; do
  sync_tree "$dst"
done
