evals/*/runs/
.DS_Store
*.swp
*.swo

# app-skill build output (keep the dir, ignore artifacts)
dist/*
!dist/.keep

# generated by tools/build-docs from skills/*/catalog.md + docs/catalog.yml
docs/index.html
docs/skills.json
docs/guide/

.claude/

# baseline banks: the runner text is regenerable with --build-bank and stochastic,
# so committing it buys no reproducibility — a rebuild yields an equivalent bank,
# never the same one — while growing the repo by ~560K per baseline, forever.
# Ignore files rather than the directory: a directory-level ignore cannot be
# undone by a negation for something inside it, and the manifest is worth keeping.
skills/*/evals/baseline-bank/**/*.out

# The manifest, though, is 4K of provenance: chunk_prompt_sha256 pins exactly which
# chunk prompts a calibration was measured on, and that hash appears nowhere in the
# results or null files. Keep it so a rebuilt bank can be checked against the original.
!skills/*/evals/baseline-bank/*/manifest.json
